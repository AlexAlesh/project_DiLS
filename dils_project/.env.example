# ============================================================
# DiLS — пример переменных окружения.
# Скопируйте в .env и настройте под себя:
#   cp .env.example .env
# ============================================================

# ---------- Django ----------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# ---------- База данных ----------
# sqlite | postgres
DB_ENGINE=sqlite

# Заполните для PostgreSQL:
# DB_ENGINE=postgres
# DB_NAME=dils
# DB_USER=dils
# DB_PASSWORD=secret
# DB_HOST=127.0.0.1
# DB_PORT=5432